<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext disabled and only system CAs trusted: user-installed CAs cannot intercept this app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Local development backend from the Android emulator (debug convenience). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
