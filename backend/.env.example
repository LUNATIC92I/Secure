# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Ed25519 seed (base64, 32 bytes) used to sign rule packs:
#   cd ../app && dart run tool/sign_rulepack.dart --generate
# Add the printed PUBLIC KEY to trustedRuleSigningKeys in app/lib/detection/rule_pack.dart.
SENTINEL_RULES_SIGNING_SEED=
# One-time token to register the first admin; clear it afterwards.
SENTINEL_ADMIN_BOOTSTRAP_TOKEN=
# Optional reputation providers (server-side only).
SENTINEL_VIRUSTOTAL_API_KEY=
SENTINEL_GOOGLE_WEBRISK_API_KEY=
SENTINEL_RATE_LIMIT_PER_MINUTE=60
